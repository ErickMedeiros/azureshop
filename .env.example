PORT=3000
APP_ENV=development
DB_PROVIDER=sqlite
SQLITE_PATH=./data/loja.db
# No App Service, configure variáveis de ambiente pela plataforma:
# APP_ENV=production e NODE_ENV=production.
# Runtime gerenciado: respeite PORT fornecida pela plataforma.
# Container: alinhe PORT com a porta de destino do App Service.
# Configure o Health Check do App Service em /api/health.
# Para Azure SQL, use DB_PROVIDER=sqlserver e configure:
# AZURE_SQL_SERVER=servidor.database.windows.net
# AZURE_SQL_DATABASE=imersao
# AZURE_SQL_AUTH=managedIdentity
# Habilite a identidade gerenciada e conceda acesso ao banco.
# A troca de provider não migra os dados do SQLite.
# Não publique arquivos com segredos; use identidade gerenciada ou referências ao Key Vault.
AI_ENABLED=false
# AZURE_OPENAI_ENDPOINT=https://seu-recurso.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
